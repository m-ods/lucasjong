---
import type { Photo } from "../data/shoots";

interface Props {
  photo: Photo;
  title: string;
  shootId: string;
  index: number;
}

const { photo, title, shootId, index } = Astro.props;
const eager = index < 6;
---

<button
  type="button"
  class="photo"
  data-shoot={shootId}
>
  <img
    src={photo.src800}
    srcset={`${photo.src800} 800w, ${photo.src} 1600w`}
    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
    width={photo.width}
    height={photo.height}
    alt={photo.alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={index === 0 ? "high" : undefined}
  />
  <span class="photo__meta" aria-hidden="true">{title}</span>
</button>
