---
import { shoots } from "../data/shoots";
import Photo from "./Photo.astro";

const featured = shoots.slice(0, 2);
const rest = shoots.slice(2);
---

<section class="section wrap" id="work">
  <h2>Work</h2>

  <div class="photos-featured">
    {
      featured.map((shoot, i) => (
        <Photo photo={shoot.cover} title={shoot.title} shootId={shoot.id} index={i} />
      ))
    }
  </div>

  <div class="photos">
    {
      rest.map((shoot, i) => (
        <Photo
          photo={shoot.cover}
          title={shoot.title}
          shootId={shoot.id}
          index={i + featured.length}
        />
      ))
    }
  </div>
</section>

<div
  class="lightbox"
  id="lightbox"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Shoot gallery"
  tabindex="-1"
>
  <button type="button" class="lightbox__close" data-close>Close</button>
  <button type="button" class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Previous photo">
    Prev
  </button>
  <img alt="" />
  <p class="lightbox__caption"></p>
  <button type="button" class="lightbox__nav lightbox__nav--next" data-next aria-label="Next photo">
    Next
  </button>
</div>

<script>
  import { shoots } from "../data/shoots";

  const lightbox = document.querySelector<HTMLDivElement>("#lightbox");
  if (lightbox && lightbox.parentElement !== document.body) {
    document.body.append(lightbox);
  }
  const img = lightbox?.querySelector("img");
  const caption = lightbox?.querySelector(".lightbox__caption");
  const prevBtn = lightbox?.querySelector<HTMLButtonElement>("[data-prev]");
  const nextBtn = lightbox?.querySelector<HTMLButtonElement>("[data-next]");
  let gallery = shoots[0]?.photos ?? [];
  let current = 0;

  function render() {
    if (!img || !caption || !lightbox) return;
    const photo = gallery[current];
    if (!photo) return;
    img.src = photo.src;
    img.alt = photo.alt;
    const shoot = shoots.find((item) => item.photos.some((entry) => entry.id === photo.id));
    caption.textContent =
      gallery.length > 1
        ? `${shoot?.title ?? ""} · ${current + 1} / ${gallery.length}`
        : (shoot?.title ?? "");
    const many = gallery.length > 1;
    if (prevBtn) prevBtn.hidden = !many;
    if (nextBtn) nextBtn.hidden = !many;
  }

  function open(shootId: string) {
    const shoot = shoots.find((item) => item.id === shootId);
    if (!shoot || !lightbox) return;
    gallery = shoot.photos;
    current = 0;
    render();
    document.documentElement.classList.add("lightbox-open");
    lightbox.hidden = false;
    lightbox.focus({ preventScroll: true });
  }

  function close() {
    if (!lightbox || lightbox.hidden) return;
    lightbox.hidden = true;
    document.documentElement.classList.remove("lightbox-open");
  }

  function step(delta: number) {
    if (gallery.length < 2) return;
    current = (current + delta + gallery.length) % gallery.length;
    render();
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".photo[data-shoot]")) {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      open(button.dataset.shoot ?? "");
    });
  }

  lightbox?.querySelector("[data-close]")?.addEventListener("click", close);
  prevBtn?.addEventListener("click", () => step(-1));
  nextBtn?.addEventListener("click", () => step(1));
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) close();
  });

  let touchX = 0;
  lightbox?.addEventListener("touchstart", (event) => {
    touchX = event.changedTouches[0]?.clientX ?? 0;
  }, { passive: true });
  lightbox?.addEventListener("touchend", (event) => {
    const dx = (event.changedTouches[0]?.clientX ?? 0) - touchX;
    if (dx > 50) step(-1);
    if (dx < -50) step(1);
  }, { passive: true });

  document.addEventListener("keydown", (event) => {
    if (!lightbox || lightbox.hidden) return;
    if (event.key === "Escape") close();
    if (event.key === "ArrowRight") step(1);
    if (event.key === "ArrowLeft") step(-1);
  });
</script>
